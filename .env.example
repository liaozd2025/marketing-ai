DATABASE_URL=postgresql://marketing_ai:marketing_ai@localhost:5432/marketing_ai
SESSION_SECRET=replace-with-at-least-32-random-characters

# Primary domestic OpenAI-compatible provider (DashScope defaults).
DASHSCOPE_API_KEY=
AGENT_DOMESTIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_TEXT_MODEL=qwen-plus
AGENT_IMAGE_MODEL=qwen-image-plus
AGENT_EMBEDDING_MODEL=text-embedding-v4

# Independently switchable secondary provider.
AGENT_SECONDARY_API_KEY=
AGENT_SECONDARY_BASE_URL=https://api.siliconflow.cn/v1
# Capability-specific endpoint/key overrides are optional.
# AGENT_SECONDARY_TEXT_API_KEY=
# AGENT_SECONDARY_TEXT_BASE_URL=
AGENT_SECONDARY_TEXT_MODEL=Qwen/Qwen3-30B-A3B
# AGENT_SECONDARY_IMAGE_API_KEY=
# AGENT_SECONDARY_IMAGE_BASE_URL=
AGENT_SECONDARY_IMAGE_MODEL=Kwai-Kolors/Kolors
# AGENT_SECONDARY_EMBEDDING_API_KEY=
# AGENT_SECONDARY_EMBEDDING_BASE_URL=
AGENT_SECONDARY_EMBEDDING_MODEL=BAAI/bge-m3

# Optional comma-separated routing overrides. Development defaults append
# deterministic test providers; production defaults contain only the two real
# providers above.
# AGENT_TEXT_PROVIDER_ORDER=domestic-text,secondary-text
# AGENT_IMAGE_PROVIDER_ORDER=domestic-image,secondary-image
# AGENT_EMBEDDING_PROVIDER_ORDER=domestic-embedding,secondary-embedding
