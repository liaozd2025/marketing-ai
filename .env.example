DATABASE_URL=postgresql://marketing_ai:marketing_ai@localhost:5432/marketing_ai
SESSION_SECRET=replace-with-at-least-32-random-characters

# Primary domestic OpenAI-compatible provider (DashScope defaults).
DASHSCOPE_API_KEY=
AGENT_DOMESTIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_TEXT_MODEL=qwen-plus
AGENT_IMAGE_MODEL=qwen-image-plus
# Multimodal embedding uses DashScope's native endpoint, not compatible-mode.
AGENT_DOMESTIC_MULTIMODAL_BASE_URL=https://dashscope.aliyuncs.com
AGENT_EMBEDDING_MODEL=qwen3-vl-embedding

# Independently switchable secondary provider.
AGENT_SECONDARY_API_KEY=
AGENT_SECONDARY_BASE_URL=https://api.siliconflow.cn/v1
# Capability-specific endpoint/key overrides are optional.
# AGENT_SECONDARY_TEXT_API_KEY=
# AGENT_SECONDARY_TEXT_BASE_URL=
AGENT_SECONDARY_TEXT_MODEL=Qwen/Qwen3-30B-A3B
# AGENT_SECONDARY_IMAGE_API_KEY=
# AGENT_SECONDARY_IMAGE_BASE_URL=
AGENT_SECONDARY_IMAGE_MODEL=Kwai-Kolors/Kolors
# AGENT_SECONDARY_EMBEDDING_API_KEY=
# AGENT_SECONDARY_EMBEDDING_BASE_URL=
# This OpenAI-compatible fallback handles text queries only. Image indexing
# requires the domestic multimodal provider (or the development test provider).
AGENT_SECONDARY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Optional comma-separated routing overrides. Development defaults append
# deterministic test providers; production defaults contain only the two real
# providers above.
# AGENT_TEXT_PROVIDER_ORDER=domestic-text,secondary-text
# AGENT_IMAGE_PROVIDER_ORDER=domestic-image,secondary-image
# AGENT_EMBEDDING_PROVIDER_ORDER=domestic-embedding,secondary-embedding

# Optional. Defaults to .data/assets under the Web process working directory.
# ASSET_STORAGE_DIR=/absolute/path/to/marketing-ai-assets

# Template composition output. Defaults to .data/compositions under the Web
# process working directory. Both directories need persistent volumes in
# production.
# COMPOSITION_STORAGE_DIR=/absolute/path/to/marketing-ai-compositions

# Optional when Puppeteer's installed Chrome is unavailable or a system browser
# is preferred.
# CHROMIUM_EXECUTABLE_PATH=/absolute/path/to/chrome
# Keep Chromium sandboxing enabled by default. Only use 1 in a separately
# isolated runtime whose platform cannot launch Chrome's sandbox.
# CHROMIUM_DISABLE_SANDBOX=0
