{
  "name": "@marketing-ai/agent-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "acceptance:http": "tsx scripts/content-skills-http-acceptance.ts",
    "acceptance:member-touch": "tsx scripts/member-touch-http-acceptance.ts",
    "dev": "node --env-file-if-exists=../../apps/web/.env.local --import tsx --watch src/run.ts",
    "start": "node --env-file-if-exists=../../apps/web/.env.local --import tsx src/run.ts",
    "once": "node --env-file-if-exists=../../apps/web/.env.local --import tsx src/run.ts --once",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marketing-ai/agent-service": "workspace:*",
    "@marketing-ai/asset-storage": "workspace:*",
    "@marketing-ai/content-skills": "workspace:*",
    "@marketing-ai/database": "workspace:*",
    "@marketing-ai/vertical-packs": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "pg": "^8.22.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6"
  }
}
