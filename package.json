{
  "name": "marketing-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm --filter @marketing-ai/web build",
    "db:migrate": "pnpm --filter @marketing-ai/database migrate",
    "dev": "docker compose up -d --wait db && pnpm db:migrate && pnpm --parallel --filter @marketing-ai/web --filter @marketing-ai/agent-worker run dev",
    "dev:down": "docker compose down",
    "lint": "eslint . --max-warnings=0",
    "renderer:install-browser": "pnpm --filter @marketing-ai/html-renderer install-browser",
    "renderer:smoke": "pnpm --filter @marketing-ai/html-renderer test",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "verify:composition-api": "pnpm --filter @marketing-ai/web verify:composition-api",
    "worker": "pnpm --filter @marketing-ai/agent-worker start",
    "worker:once": "pnpm --filter @marketing-ai/agent-worker once"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.0"
  }
}
