{
  "name": "marketing-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm --filter @marketing-ai/web build",
    "db:migrate": "pnpm --filter @marketing-ai/database migrate",
    "dev": "docker compose up -d --wait db && pnpm db:migrate && pnpm --filter @marketing-ai/web dev",
    "dev:down": "docker compose down",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.0"
  }
}
